{
  "checks": [
    {
      "name": "app_settings_singleton",
      "table": "app_settings",
      "definition": "CHECK ((id = 1))"
    },
    {
      "name": "attire_items_role_check",
      "table": "attire_items",
      "definition": "CHECK ((role = ANY (ARRAY['bride'::text, 'groom'::text, 'family'::text, 'party'::text, 'guest'::text, 'other'::text])))"
    },
    {
      "name": "attire_items_status_check",
      "table": "attire_items",
      "definition": "CHECK ((status = ANY (ARRAY['confirmed'::text, 'inspiration'::text])))"
    },
    {
      "name": "events_event_type_check",
      "table": "events",
      "definition": "CHECK ((event_type = ANY (ARRAY['ceremony'::text, 'reception'::text, 'gathering'::text, 'other'::text])))"
    },
    {
      "name": "guest_events_rsvp_status_check",
      "table": "guest_events",
      "definition": "CHECK ((rsvp_status = ANY (ARRAY['confirmed'::text, 'pending'::text, 'declined'::text])))"
    },
    {
      "name": "guests_invite_or_not_check",
      "table": "guests",
      "definition": "CHECK (((invite_or_not IS NULL) OR (invite_or_not = ANY (ARRAY['Invite'::text, 'Not 100%'::text]))))"
    },
    {
      "name": "guests_party_size_positive",
      "table": "guests",
      "definition": "CHECK (((party_size IS NULL) OR ((party_size >= 1) AND (party_size <= 40))))"
    },
    {
      "name": "guests_side_check",
      "table": "guests",
      "definition": "CHECK ((side = ANY (ARRAY['bride'::text, 'groom'::text, 'both'::text, 'groom mom'::text, 'groom dad'::text])))"
    },
    {
      "name": "tasks_recur_freq_check",
      "table": "tasks",
      "definition": "CHECK (((recur_freq IS NULL) OR (recur_freq = ANY (ARRAY['daily'::text, 'weekly'::text, 'monthly'::text]))))"
    },
    {
      "name": "tasks_status_check",
      "table": "tasks",
      "definition": "CHECK ((status = ANY (ARRAY['todo'::text, 'in_progress'::text, 'done'::text])))"
    },
    {
      "name": "vendors_contract_status_check",
      "table": "vendors",
      "definition": "CHECK ((contract_status = ANY (ARRAY['enquiry'::text, 'quoted'::text, 'booked'::text, 'paid'::text, 'cancelled'::text])))"
    }
  ],
