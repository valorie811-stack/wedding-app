# Copy to .env.local and fill in. Keep this example file's values EMPTY.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser). REQUIRED for the app to read/write
# your live data and to store the owner PIN. All DB access is server-side and
# uses this key (bypasses RLS). Without it the app falls back to seed/preview.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the owner PIN session cookie. Set a long random string
# (e.g. `openssl rand -hex 32`). REQUIRED in production.
APP_SESSION_SECRET=

# Optional: preview/demo PIN when Supabase is NOT connected. Lets you lock the
# app locally without a backend. Ignored once Supabase is configured (the PIN is
# then set on first run and stored in app_settings).
APP_PIN=

# Optional: live FX for the Combined Finance page (exchangerate-api.com v6).
# Get a free key at https://www.exchangerate-api.com. If omitted, the app uses
# the static VND/MYR->AUD rates in lib/format.js.
EXCHANGE_RATE_API_KEY=

# Optional: email via Resend — powers the monthly RSVP digest, new-RSVP alerts,
# and weekly task reminders sent to you. Without these, they no-op gracefully.
RESEND_API_KEY=
RESEND_FROM="Two Weddings <noreply@yourdomain.com>"
# Comma-separated recipients for your notification emails (e.g. bride + groom).
DIGEST_RECIPIENTS=
# Protects the /api/digest and /api/reminders cron endpoints. Vercel Cron sends
# it automatically when set as a project env var; also accepted as ?key= for
# manual runs.
CRON_SECRET=
