# Supabase — copy to .env.local and fill in from your Supabase project
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser). Used for token-gated share routes later.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL for magic-link auth redirects
NEXT_PUBLIC_SITE_URL=

# Optional: live FX for the Combined Finance page (exchangerate-api.com v6).
# Get a free key at https://www.exchangerate-api.com. If omitted, the app uses
# the static VND/MYR->AUD rates in lib/format.js.
EXCHANGE_RATE_API_KEY=

# Optional (Phase 4): email via Resend — powers the monthly RSVP digest and the
# email-OTP gate on share links. Without these, both features no-op gracefully.
RESEND_API_KEY=
RESEND_FROM="Two Weddings <noreply@yourdomain.com>"
# Comma-separated recipients for couple/planner emails: monthly digest,
# new-RSVP alerts, and weekly task reminders (e.g. you + your planner).
DIGEST_RECIPIENTS=
# Protects the /api/digest cron endpoint. Vercel Cron sends it automatically
# when set as a project env var; also accepted as ?key= for manual runs.
CRON_SECRET=
